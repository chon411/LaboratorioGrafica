# Archivo OBJ - Plano para textura
mtllib hombre.mtl

# Vértices (x, y, z)
v -1.0 -1.0 0.0
v  1.0 -1.0 0.0
v  1.0  1.0 0.0
v -1.0  1.0 0.0

# Coordenadas UV (u, v)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Normales (nx, ny, nz)
vn 0.0 0.0 1.0

# Definición del material y cara (v/vt/vn)
usemtl Material_Hombre
f 1/1/1 2/2/1 3/3/1 4/4/1